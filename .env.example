# Whatsapp notification.
# true|false
WA_NOTIFICATION=false
# Provider: Auto|Fonnte|OpenWA|ApiMe|EvolutionAPI|Wuzapi
#   Auto         -> acak, hanya dari provider yang WHATSAPP_TOKEN_<Provider>-nya diisi
#   Fonnte       -> layanan berbayar, ambil token di https://md.fonnte.com/
#   OpenWA       -> self-hosted, https://github.com/rmyndharis/OpenWA
#   ApiMe        -> self-hosted, https://github.com/open-apime/apime
#   EvolutionAPI -> self-hosted, https://github.com/evolution-foundation/evolution-api
#   Wuzapi       -> self-hosted, https://github.com/asternic/wuzapi
WHATSAPP_PROVIDER=Auto
WHATSAPP_TOKEN_Wuzapi=XXXXXXXXXXXXXXXXX
WHATSAPP_TOKEN_ApiMe=XXXXXXXXXXXXXXXXX
WHATSAPP_TOKEN_Fonnte=XXXXXXXXXXXXXXXXX
WHATSAPP_TOKEN_OpenWA=XXXXXXXXXXXXXXXXX
# Base URL gateway, khusus provider self-hosted.
# Pakai kunci per-provider: itulah yang memungkinkan beberapa gateway
# dikonfigurasi bersamaan. Kalau kunci per-provider kosong, barulah
# WHATSAPP_URL dipakai; kalau itu pun kosong, tiap provider memakai bawaannya.
#   OpenWA       -> https://openwa.whatsapp.com (token = API key, header X-API-Key)
#   ApiMe        -> https://api-me.whatsapp.com (token = instance token, header Bearer)
#   EvolutionAPI -> https://evolution-api.whatsapp.com (token = API key global atau token instance, header apikey)
#   Wuzapi       -> https://wuzapi.whatsapp.com (token = token user, header Token)
WHATSAPP_URL_OpenWA=
WHATSAPP_URL_ApiMe=
WHATSAPP_URL_EvolutionAPI=
WHATSAPP_URL_Wuzapi=
# Cadangan umum, dipakai HANYA kalau kunci per-provider di atas kosong.
# Jangan diisi kalau tiap gateway sudah punya kunci sendiri: nilai ini
# berlaku untuk provider apa pun yang sedang aktif.
WHATSAPP_URL=
# Khusus OpenWA: id session yang sudah di-start dan scan QR.
WHATSAPP_SESSION=
# Khusus ApiMe (UUID instance) dan EvolutionAPI (nama instance).
# Wuzapi tidak memakainya: tokennya sendiri yang menentukan sesi.
WHATSAPP_INSTANCE=
# Batas waktu request ke gateway, detik (1-60, default 10).
# Halaman scan absen menunggu selama ini, jadi jangan terlalu besar.
WHATSAPP_TIMEOUT=10
